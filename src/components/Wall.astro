---
import Clip from './Clip.astro';
import { ratio, type Clip as ClipEntry } from '../lib/media';

interface Props {
  rows: ClipEntry[][];
  /** The packing target the rows were built with (see pack() in lib/media.ts). */
  target?: number;
  /** Chip text: the clip's title by default; 'tool' prefixes the tool name. */
  label?: 'title' | 'tool';
}

const { rows, target = 5, label = 'title' } = Astro.props;
const chip = (c: ClipEntry) => (label === 'tool' ? `${c.data.tool} · ${c.data.title}` : c.data.title);
// A short last row would otherwise stretch to full width and tower over the rest; a
// spacer takes up the share of the line its clips do not fill.
const slack = (row: ClipEntry[]) => Math.max(0, target - row.reduce((s, c) => s + ratio(c), 0));
---
<div class="wall" style="display: flex; flex-direction: column; gap: 4px">
  {rows.map((row) => (
    <div class="jrow">
      {row.map((c) => <Clip clip={c} chip={chip(c)} justified />)}
      {slack(row) > 0.01 && <span aria-hidden="true" style={`flex: ${slack(row).toFixed(4)} 1 0%`}></span>}
    </div>
  ))}
</div>
