---
// The short version, at the foot of Team. /contact/ redirects to this anchor
// (public/_redirects); the full text, with its photos, is /join/.
import { LAB, EMAIL, INSTITUTE, ADDRESS } from '../lib/site';
---
<section class="ledger" id="join" aria-labelledby="join-h">
  <header class="ledger-head">
    <h2 id="join-h">Join the team</h2>
  </header>
  <div class="split">
    <div class="prose">
      <p class="lede">
        Interested in our work? Reach out to <a href={`mailto:${EMAIL}`}>{EMAIL}</a> with your
        CV to discuss potential opportunities at any level.
      </p>
      <p>
        We recruit software engineers, postdoctoral fellows, graduate students through UCSD,
        and high school and undergraduate interns. We do not currently have open positions,
        but we are always happy to talk.
      </p>
      <p><a class="more" href="/join/">Opportunities, philosophy and location</a></p>
    </div>
    <address class="note" style="font-style: normal">
      <strong style="color: var(--text)">{LAB}</strong><br />
      {INSTITUTE}<br />
      {ADDRESS.map((l) => <>{l}<br /></>)}
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </address>
  </div>
</section>
