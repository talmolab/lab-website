---
import { videoUrl, posterUrl, type Clip } from '../lib/media';

interface Props {
  raw: Clip;
  kp: Clip;
}

const { raw, kp } = Astro.props;
const modes = [
  { key: 'raw', label: 'Video' },
  { key: 'both', label: 'Video + keypoints' },
  { key: 'kp', label: 'Keypoints' },
];
---
{/* Two encodes of the same frames, the keypoints on black. Screen-blending the second
    over the first makes its black transparent, so the layers can be switched in place. */}
<div class="split" data-layers-root>
  <div style="display: flex; flex-direction: column; gap: 14px">
    <slot />
    <div class="seg" role="group" aria-label="Show">
      {modes.map((m) => (
        <button type="button" data-mode={m.key} aria-pressed={m.key === 'both' ? 'true' : 'false'}>{m.label}</button>
      ))}
    </div>
  </div>
  <div class="layers" data-mode="both" style={`aspect-ratio: ${raw.data.width} / ${raw.data.height}`}>
    <video class="raw" src={videoUrl(raw)} poster={posterUrl(raw)} muted loop playsinline preload="none" data-auto aria-label={raw.data.title}></video>
    <video class="kp" src={videoUrl(kp)} poster={posterUrl(kp)} muted loop playsinline preload="none" data-auto aria-hidden="true"></video>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-layers-root]')) {
    const stack = root.querySelector<HTMLElement>('.layers')!;
    const [raw, kp] = [...stack.querySelectorAll<HTMLVideoElement>('video')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')];
    for (const b of buttons) {
      b.addEventListener('click', () => {
        stack.dataset.mode = b.dataset.mode;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      });
    }
    // Keep the keypoint layer on the raw layer's clock.
    raw.addEventListener('timeupdate', () => {
      if (Math.abs(kp.currentTime - raw.currentTime) > 0.12) kp.currentTime = raw.currentTime;
    });
  }
</script>
