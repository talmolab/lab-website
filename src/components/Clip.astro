---
import { videoUrl, posterUrl, shape, type Clip } from '../lib/media';

interface Props {
  clip: Clip;
  /** Label drawn on the footage. `true` uses the clip's title; false for none. */
  chip?: string | boolean;
  /** Letterbox instead of cropping. */
  contain?: boolean;
  /** Set --ar/--w/--h for a justified row. */
  justified?: boolean;
  class?: string;
}

const { clip, chip = false, contain = false, justified = false, class: cls } = Astro.props;
const label = chip === true ? clip.data.title : chip || undefined;
---
<figure class:list={['frame', { contain }, cls]} style={justified ? shape(clip) : undefined}>
  {/* Autoplay is done in script (Shell.astro): only when on screen, only while motion is
      on, never under prefers-reduced-motion unless the visitor turns it on. Without JS
      the poster stands in. */}
  <video
    src={videoUrl(clip)}
    poster={posterUrl(clip)}
    width={clip.data.width}
    height={clip.data.height}
    muted
    loop
    playsinline
    preload="none"
    data-auto
    aria-label={clip.data.title}
  ></video>
  {label && <span class="chip">{label}</span>}
</figure>
