---
// One publication. Used on Publications (with a thumbnail), and compact on Home,
// Research and member pages. Lab members are set in bold in the author list, matched
// on first and last name (src/lib/names.ts), and linked to their page when they have
// one. Co-first, corresponding and jointly supervising authors carry *, † and ‡ (the
// overlay's `equal:`, `corresponding:` and `senior:`); /publications/ prints the
// legend, and each mark has a tooltip.
import { getCollection, type CollectionEntry } from 'astro:content';
import { thumbInfo, href, fmtDate, isPreprintVenue } from '../lib/pubs';
import { nameKey } from '../lib/names';

interface Props {
  pub: CollectionEntry<'publications'>;
  /** nameKeys of everyone in the people collection. */
  lab: Set<string>;
  compact?: boolean;
  /** Carry the search hooks used by the Publications filter. */
  filterable?: boolean;
  /** Heading level for the title, so each page's outline stays correct. */
  level?: 'h2' | 'h3' | 'h4';
  /** Shorten the author list only past this many authors. Defaults to 60 for full
   *  rows and 12 for compact ones; member pages pass 60. */
  collapseAt?: number;
}

const { pub, lab, compact = false, filterable = false, level = 'h3', collapseAt } = Astro.props;
const p = pub.data;
const t = compact ? undefined : await thumbInfo(p.image);
const link = href(p);
const pdf = p.url?.endsWith('.pdf') ? p.url : undefined;
const H = level;
// "first last" forms of every author, so a search for "Talmo Pereira" also finds
// "Talmo D. Pereira" (the Greene search matched raw text only).
const names = p.authors.map(nameKey).join(' | ');

// Lab members with a page get a link to it, aliases included, except on that page.
const here = Astro.url.pathname.replace(/(\.html|\/)$/, '');
const pages = new Map<string, string>();
for (const m of await getCollection('people', ({ data }) => data.page))
  for (const n of [m.data.name, ...m.data.aliases]) pages.set(nameKey(n), `/members/${m.id}`);

// In footnote order, which is also the order they follow a name in.
const MARKS = [
  { names: p.equal, sym: '*', label: 'Equal contribution' },
  { names: p.corresponding, sym: '†', label: 'Corresponding author' },
  { names: p.senior, sym: '‡', label: 'Jointly supervised' },
].map((m) => ({ ...m, keys: new Set(m.names.map(nameKey)) }));
type Mark = { sym: string; label: string };
type Author = { name: string; bold: boolean; href?: string; marks: Mark[] };
const authors: Author[] = p.authors.map((name) => {
  const k = nameKey(name);
  const page = pages.get(k);
  return {
    name,
    bold: lab.has(k),
    href: lab.has(k) && page !== here ? page : undefined,
    marks: MARKS.filter((m) => m.keys.has(k)),
  };
});

// Long author lists are shortened to the first three, every lab member, every marked
// author and the last author, with an ellipsis for each gap. Full rows (Publications)
// almost never shorten: only past 60 authors, and they expand in place. Compact rows
// on Home shorten past 12, the old full-row limit, and give the count; member pages
// pass `collapseAt={60}` so a person's papers read like the Publications page.
type Bit = Author | { gap: true };
const limit = collapseAt ?? (compact ? 12 : 60);
function shown(all: Author[]): Bit[] {
  if (all.length <= limit) return all;
  const keep = new Set([0, 1, 2, all.length - 1]);
  all.forEach((a, i) => (a.bold || a.marks.length) && keep.add(i));
  const out: Bit[] = [];
  let prev = -1;
  for (const i of [...keep].sort((x, y) => x - y)) {
    if (i - prev > 1) out.push({ gap: true });
    out.push(all[i]);
    prev = i;
  }
  return out;
}
const bits = shown(authors);
const shortened = bits.length < authors.length;
---
<li
  class="pub"
  id={compact ? undefined : p.key}
  data-pub={filterable ? '' : undefined}
  data-names={filterable ? names : undefined}
  data-tags={filterable && p.tags.length ? p.tags.join('|') : undefined}
>
  {!compact && (
    t ? (
      <div class:list={['pub-thumb', { box: !t.width }]} data-venue={t.width ? undefined : (p.venue ?? '')}>
        <img src={t.src} alt="" width={t.width} height={t.height} loading="lazy" decoding="async" />
      </div>
    ) : (
      <div class="pub-thumb none" aria-hidden="true">{p.venue ?? ''}</div>
    )
  )}
  <div>
    <H class="pub-title">{link ? <a href={link}>{p.title}</a> : p.title}</H>
    <p class="pub-authors">
      {bits.map((b, i) => (
        <>
          {'gap' in b ? '…' : (
            <>
              {b.bold ? <b>{b.href ? <a href={b.href}>{b.name}</a> : b.name}</b> : b.name}
              {b.marks.map((m) => <sup class="mark" title={m.label}><span aria-hidden="true">{m.sym}</span><span class="vh">({m.label.toLowerCase()})</span></sup>)}
            </>
          )}
          {i < bits.length - 1 ? ', ' : ''}
        </>
      ))}
      {shortened && compact && <span class="nowrap"> ({p.authors.length} authors)</span>}
    </p>
    {shortened && !compact && (
      <details class="all-authors">
        <summary>All {p.authors.length} authors</summary>
        <p class="pub-authors">
          {authors.map((a, i) => (
            <>
              {a.bold ? <b>{a.href ? <a href={a.href}>{a.name}</a> : a.name}</b> : a.name}
              {a.marks.map((m) => <sup class="mark" title={m.label}><span aria-hidden="true">{m.sym}</span><span class="vh">({m.label.toLowerCase()})</span></sup>)}
              {i < authors.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
      </details>
    )}
    <p class="pub-venue">
      {p.venue && <i>{p.venue}</i>}
      {p.venue && p.date && ' · '}
      {p.date && <span class="muted"><time datetime={p.date}>{fmtDate(p.date)}</time></span>}
      {isPreprintVenue(p.venue) && <span class="muted"> · preprint</span>}
    </p>
    {!compact && (
      <p class="pub-links">
        {p.doi && <a href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a>}
        {pdf && <a href={pdf}>PDF</a>}
        {p.preprint?.doi && (
          <a href={p.preprint.url ?? `https://doi.org/${p.preprint.doi}`}>
            Preprint{p.preprint.venue ? ` (${p.preprint.venue})` : ''}
          </a>
        )}
        {p.links.map((l) => <a href={l.url}>{l.label}</a>)}
      </p>
    )}
  </div>
</li>

<style>
  /* A lab member's name links to their page. It stays a name, in text colour, so the
     list does not turn violet; the underline (a fainter one than body links get) says
     it is a link, and the global :focus-visible outline still marks focus. */
  .pub-authors a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
  }

  .pub-authors a:hover {
    text-decoration-color: currentColor;
  }

  /* * equal contribution, † corresponding author, ‡ jointly supervised. line-height: 0
     keeps the mark from opening up the line it sits on. */
  .mark {
    margin-left: 0.05em;
    font-size: 0.75em;
    line-height: 0;
  }
</style>
