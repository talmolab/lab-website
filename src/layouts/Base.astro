---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { DESCRIPTION, LAB } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Path of an image under public/ for link unfurls; defaults to the brand card. */
  ogImage?: string;
}

const { title, description = DESCRIPTION, ogImage = '/og-card.png' } = Astro.props;

const fullTitle = title ? `${title} · ${LAB}` : `${LAB} · Salk Institute`;
const site = Astro.site!;
// Member pages are flat files served without a trailing slash (build.format: 'preserve');
// everything else is a directory route served with one.
const canonicalPath = Astro.url.pathname.startsWith('/members/')
  ? Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '')
  : Astro.url.pathname;
const canonical = new URL(canonicalPath, site).href;
const og = new URL(ogImage, site).href;
// Anything that is not the production host is a preview: keep it out of search
// results so it cannot compete with talmolab.org (robots.txt says the same).
const isPreview = site.hostname !== 'talmolab.org';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    {/* Before first paint: the stored theme, and a flag that JS is running so the CSS
        can fold the mobile menu (without JS the links simply stay visible). */}
    <script is:inline>
      (function () {
        var d = document.documentElement, t;
        d.classList.add('js');
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'light' || t === 'dark') d.dataset.theme = t;
      })();
    </script>

    <Font cssVariable="--font-sans-src" preload />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={LAB} />
    <meta property="og:title" content={title ?? LAB} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The talmolab logo: a lowercase t drawn as a neuron with a dendritic arbor, beside an l with a pose skeleton." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@talmop" />
    <meta name="twitter:image" content={og} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/talmolab-favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141319" />
    <meta name="color-scheme" content="light dark" />
    <link rel="alternate" type="application/rss+xml" title={LAB} href="/feed.xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SearchDialog />

    <script>
      // Clips: play while on screen, unless the visitor prefers reduced motion or paused
      // this clip. Each clip's own button (and a click on the clip) plays or pauses it.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)');
      const visible = new WeakMap<HTMLVideoElement, boolean>();

      function sync(v: HTMLVideoElement) {
        const choice = v.dataset.choice; // 'play' | 'pause' | undefined
        const want = !!visible.get(v) && (choice ? choice === 'play' : !reduce.matches);
        if (want) {
          v.play().catch(() => {});
        } else if (!v.paused) {
          v.pause();
        }
      }

      function paint(v: HTMLVideoElement) {
        const b = v.parentElement?.querySelector<HTMLButtonElement>('[data-clip-toggle]');
        if (!b) return;
        const playing = !v.paused;
        b.setAttribute('aria-label', playing ? 'Pause clip' : 'Play clip');
        b.setAttribute('aria-pressed', String(!playing));
        b.dataset.state = playing ? 'playing' : 'paused';
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            visible.set(v, e.isIntersecting);
            if (e.isIntersecting && v.preload === 'none') v.preload = 'auto';
            sync(v);
          }
        },
        { rootMargin: '120px 0px' },
      );

      for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-clip]')) {
        v.muted = true;
        io.observe(v);
        v.addEventListener('play', () => paint(v));
        v.addEventListener('pause', () => paint(v));
        const flip = () => {
          v.dataset.choice = v.paused ? 'play' : 'pause';
          if (v.dataset.choice === 'play') visible.set(v, true);
          sync(v);
        };
        v.addEventListener('click', flip);
        v.parentElement?.querySelector('[data-clip-toggle]')?.addEventListener('click', flip);
        paint(v);
      }
      reduce.addEventListener('change', () => {
        for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-clip]')) sync(v);
      });
    </script>
  </body>
</html>
