---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import PubRow from '../components/PubRow.astro';
import { team } from '../lib/people';
import { allPubs } from '../lib/pubs';
import { nameKey } from '../lib/names';
import { EMAIL, INSTITUTE } from '../lib/site';
import labPhoto from '../assets/pages/2024-08-06.lab-group1.jpg';

const areas = (await getCollection('areas', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const { members, alumni, all } = await team();
const lab = new Set(all.flatMap((p) => [p.data.name, ...p.data.aliases].map(nameKey)));
const pubs = await allPubs();
const recent = pubs.slice(0, 5);
const repos = (await getCollection('repos'))
  .filter((r) => r.data.group === 'maintained')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 5);
const letters = 'abcdefghij';
---
<Base>
  <div class="wrap">
    <section class="hero" aria-labelledby="hero-h">
      <div>
        <h1 id="hero-h" class="display">Computational tools for studying complex biological systems</h1>
        <p class="lede">
          The lab of <a href="/members/talmo-pereira">Talmo Pereira</a> at the
          <a href="https://salk.edu">{INSTITUTE}</a> builds deep learning and computer
          vision methods to capture biological motion, phenotype animals and plants at
          scale, and emulate living systems in simulation.
        </p>
        <p class="hero-links">
          <a class="more" href="/research/">Learn about our work</a>
          <a class="more" href="/join/">Join us</a>
        </p>
      </div>
      <dl class="facts">
        <div><dt>Led by</dt><dd><a class="plain" href="/members/talmo-pereira">Talmo Pereira</a></dd></div>
        <div><dt>Institute</dt><dd>{INSTITUTE}<br />La Jolla, California</dd></div>
        <div><dt>Founded</dt><dd>2021</dd></div>
        <div><dt>People</dt><dd><a class="plain" href="/team/">{members.length} in the lab, {alumni.length} alumni</a></dd></div>
        <div><dt>Software</dt><dd><a class="plain" href="/tools/">Open source, on GitHub</a></dd></div>
      </dl>
    </section>

    <section class="band first" aria-labelledby="research-h">
      <div class="section-intro">
        <h2 id="research-h">Research</h2>
        <a class="more" href="/research/">All research</a>
      </div>
      <ol class="panel" role="list" style="list-style: none; padding: 0">
        {areas.map((a, i) => {
          const m = a.data.media[0];
          return (
            <li class="panel-item" style={m ? `--ar: ${(m.width / m.height).toFixed(4)}` : '--ar: 2'}>
              <a href={`/research/#${a.id}`}>
                {m && <Media item={m} />}
                <span class="panel-cap">
                  <span class="fig-label">{letters[i]}</span>
                  <span class="panel-name">{a.data.name}</span>
                  <span class="panel-sum">{a.data.summary}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="ledger" aria-labelledby="pubs-h">
      <header class="ledger-head">
        <h2 id="pubs-h">Recent publications</h2>
        <p>Papers, preprints and proceedings. A preprint that was later published is listed once.</p>
        <a class="more" href="/publications/">All {pubs.length} publications</a>
      </header>
      <ul class="pubs compact">
        {recent.map((p) => <PubRow pub={p} lab={lab} compact />)}
      </ul>
    </section>

    <section class="ledger" aria-labelledby="people-h">
      <header class="ledger-head">
        <h2 id="people-h">People</h2>
        <p>
          Scientists, engineers and students from neuroscience, computer science, biology
          and beyond: {members.length} people in the lab today, and {alumni.length} alumni.
        </p>
        <a class="more" href="/team/">Meet the team</a>
      </header>
      <figure class="photo">
        <a href="/team/">
          <Image
            src={labPhoto}
            alt="Members of the lab, many in flannel shirts, standing and sitting in two rows on a concrete terrace at the Salk Institute."
            widths={[640, 960, 1280, 1400]}
            sizes="(min-width: 1280px) 880px, (min-width: 960px) 70vw, calc(100vw - 2 * var(--gutter))"
            class="crop-wide"
          />
        </a>
        <figcaption>The lab, ca. 2024. Photo credit: Chris Keeney.</figcaption>
      </figure>
    </section>

    <section class="ledger" aria-labelledby="tools-h">
      <header class="ledger-head">
        <h2 id="tools-h">Software</h2>
        <p>Open-source tools we build and maintain, starting with SLEAP for multi-animal pose tracking.</p>
        <a class="more" href="/tools/">All tools</a>
      </header>
      <ul class="tool-list">
        {repos.map((r) => (
          <li>
            <a class="name plain" href={`/tools/#${r.data.name}`}>{r.data.title ?? r.data.name}</a>
            <span class="desc">{(r.data.blurb ?? r.data.description ?? '').split(/(?<=\.)\s/)[0]}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="ledger" aria-labelledby="join-h">
      <header class="ledger-head">
        <h2 id="join-h">Join us</h2>
      </header>
      <div>
        <p class="lede">
          We place a high value on mentorship, work-life balance and open communication,
          and we recruit at every level: engineers, postdocs, graduate students and interns.
        </p>
        <p class="contact-line" style="margin-top: 24px">
          <a class="more" href="/join/">Opportunities</a>
          <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        </p>
      </div>
    </section>
  </div>
</Base>
