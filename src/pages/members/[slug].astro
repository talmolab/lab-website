---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubRow from '../../components/PubRow.astro';
import { roleHistory, years, isCurrent, latest, displayTitle, coAdvisorsOf, coAdvisorVerb } from '../../lib/people';
import { allPubs } from '../../lib/pubs';
import { isAuthor, nameKey } from '../../lib/names';

export async function getStaticPaths() {
  const people = await getCollection('people');
  // Not everyone in the collection has a page; those without one are still listed on
  // the team page, as plain text.
  return people.filter((p) => p.data.page).map((p) => ({ params: { slug: p.id }, props: { person: p, people } }));
}

const { person, people } = Astro.props;
const { Content } = await render(person);
const d = person.data;
const current = isCurrent(person);
const roles = current ? [displayTitle(latest(person))] : roleHistory(person);
const earlier = current ? roleHistory(person).filter((r) => !roles.includes(r)) : [];
// Genuine co-advisors only, linked to their lab where src/data/pis.yaml knows it.
const coAdvisors = await Promise.all(coAdvisorsOf(person).map(async (name) => ({ name, url: (await getEntry('pis', name))?.data.url })));
// The graduate program of the most recent appointment that has one, and current projects.
const programRef = [...d.appointments].reverse().find((a) => a.program)?.program;
const program = programRef ? (await getEntry(programRef))?.data : undefined;
const projects = current ? (await Promise.all(d.projects.map((r) => getEntry(r)))).filter((x) => !!x) : [];
const lab = new Set(people.flatMap((p) => [p.data.name, ...p.data.aliases].map(nameKey)));
const papers = (await allPubs()).filter((p) => p.data.authors.some((a) => isAuthor(person, a)));
const initials = d.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);

const l = d.links ?? {};
const strip = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const links = [
  l.email && { label: 'Email', href: `mailto:${l.email}`, show: l.email },
  l['home-page'] && { label: 'Website', href: l['home-page'], show: strip(l['home-page']) },
  l.github && { label: 'GitHub', href: `https://github.com/${l.github}`, show: l.github },
  l.scholar && {
    label: 'Google Scholar',
    href: l.scholar.startsWith('http') ? l.scholar : `https://scholar.google.com/citations?user=${l.scholar}`,
    show: '',
  },
  l.orcid && { label: 'ORCID', href: l.orcid.startsWith('http') ? l.orcid : `https://orcid.org/${l.orcid}`, show: strip(l.orcid).replace('orcid.org/', '') },
  l.linkedin && {
    label: 'LinkedIn',
    href: l.linkedin.startsWith('http') ? l.linkedin : `https://www.linkedin.com/in/${l.linkedin}`,
    show: '',
  },
  l.twitter && { label: 'X (Twitter)', href: l.twitter.startsWith('http') ? l.twitter : `https://x.com/${l.twitter}`, show: `@${l.twitter.replace(/^.*\//, '')}` },
].filter(Boolean) as { label: string; href: string; show: string }[];

// The live site's "<Name>'s papers" button, kept: it opens Publications filtered to
// this name, with the same ?search= URL.
const search = `/publications/?search=${encodeURIComponent(`"${d.name}"`)}`;
---
<Base title={d.name} description={`${d.name}, ${roles.join(', ')} in the Talmo Pereira Lab at the Salk Institute.`}>
  <div class="wrap">
    <article class="member">
      <div class="member-side">
        {d.image ? (
          <Image src={d.image} alt={`Portrait of ${d.name}`} width={640} height={640} class="portrait" loading="eager" />
        ) : (
          <span class="initials" aria-hidden="true" style="font-size: 3.5rem">{initials}</span>
        )}
        {links.length > 0 && (
          <ul class="member-links" aria-label="Links">
            {links.map((x) => (
              <li><a href={x.href}><span>{x.label}</span>{x.show && <span class="mono">{x.show}</span>}</a></li>
            ))}
          </ul>
        )}
      </div>

      <div class="member-main">
        <nav class="crumbs mono" aria-label="Breadcrumb">
          <a href="/team/">Team</a>
          <span aria-hidden="true">/</span>
          {current ? <a href="/team/#current">In the lab</a> : <a href="/team/#alumni">Alumni</a>}
        </nav>
        <h1 class="title">{d.name}</h1>
        <div class="member-role">
          <p class="roles">{roles.join(', ')}</p>
          <p class="mono muted">
            {current ? `Since ${d.appointments[0].start?.slice(0, 4) ?? '—'}` : years(person)}
            {earlier.length > 0 && <> · previously {earlier.join(', ')}</>}
            {coAdvisors.length > 0 && <> · {`${coAdvisorVerb(person)} `}{coAdvisors.map((c, i) => <>{i > 0 && ' and '}{c.url ? <a href={c.url}>{c.name}</a> : c.name}</>)}</>}
          </p>
          {program && (
            <p class="member-program"><a href={program.url}>{program.name}</a>, {program.school}</p>
          )}
          {projects.length > 0 && (
            <p class="member-projects muted">
              Projects: {projects.map((x, i) => <>{i > 0 && ', '}{x.data.url ? <a href={x.data.url}>{x.data.title ?? x.data.name}</a> : (x.data.title ?? x.data.name)}</>)}
            </p>
          )}
          {!current && d.next && (
            <p>
              Now: {d.next.url ? <a href={d.next.url}>{d.next.org}</a> : d.next.org}{d.next.what && `, ${d.next.what}`}
            </p>
          )}
        </div>
        <div class="prose"><Content /></div>

        <section class="member-papers" aria-labelledby="papers-h">
          <div class="section-intro" style="margin: 0">
            <h2 id="papers-h" class="h3">Publications{papers.length > 0 && <span class="count"> · {papers.length}</span>}</h2>
            {papers.length > 0 && <a class="more" href={search}>Search all publications for {d.name}</a>}
          </div>
          {papers.length > 0 ? (
            <ul class="pubs compact">
              {papers.map((p) => <PubRow pub={p} lab={lab} compact level="h3" />)}
            </ul>
          ) : (
            <p class="muted">No papers from the lab's publication list yet.</p>
          )}
        </section>
      </div>
    </article>
  </div>
</Base>
