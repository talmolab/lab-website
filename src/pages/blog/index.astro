---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// One merged reverse-chronological stream. Drafts never render: the discovery Action
// opens PRs with draft: true, and a person merges.
const posts = (await getCollection('posts', ({ data }) => !data.draft)).map((p) => ({
  kind: 'Post', date: p.data.date, title: p.data.title, href: `/blog/${p.id}/`, description: p.data.description,
}));
const news = (await getCollection('news', ({ data }) => !data.draft)).map((n) => ({
  kind: 'News', date: n.data.date, title: n.data.title, href: n.data.url, description: undefined,
}));
const stream = [...posts, ...news].sort((a, b) => b.date.getTime() - a.date.getTime());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog" description="Posts and news from the Talmo Pereira Lab.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="title">Blog</h1>
      <p class="lede">
        {stream.length === 0
          ? 'Posts and lab news will appear here. Nothing is published yet.'
          : 'Posts and lab news, newest first.'}
      </p>
      <p class="mono"><a href="/feed.xml">RSS feed</a></p>
    </header>
    {stream.length > 0 && (
      <section class="ledger" aria-label="Posts and news">
        <header class="ledger-head"><span class="count">{stream.length} items</span></header>
        <ul class="pubs compact">
          {stream.map((it) => (
            <li class="pub">
              <div>
                <h2 class="pub-title">{it.href ? <a href={it.href}>{it.title}</a> : it.title}</h2>
                {it.description && <p class="pub-authors">{it.description}</p>}
                <p class="pub-venue"><span class="mono muted">{it.kind} · <time datetime={it.date.toISOString()}>{fmt(it.date)}</time></span></p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
