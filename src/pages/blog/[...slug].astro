---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const authors = await getEntries(post.data.authors);
const date = post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Base title={post.data.title} description={post.data.description}>
  <div class="wrap">
    <article>
      <header class="page-head">
        <nav class="crumbs meta" aria-label="Breadcrumb"><a href="/blog/">Blog</a><span aria-hidden="true">/</span><time datetime={post.data.date.toISOString()}>{date}</time></nav>
        <h1 class="title">{post.data.title}</h1>
        {authors.length > 0 && (
          <p class="muted">
            {authors.map((a, i) => <>{i > 0 && ', '}{a.data.page ? <a href={`/members/${a.id}`}>{a.data.name}</a> : a.data.name}</>)}
          </p>
        )}
      </header>
      <div class="prose" style="padding-bottom: var(--space)"><Content /></div>
    </article>
  </div>
</Base>
