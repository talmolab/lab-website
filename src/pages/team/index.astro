---
import { Image } from 'astro:assets';
import Shell from '../../layouts/Shell.astro';
import Join from '../../components/Join.astro';
import { team, roleHistory, years, label, latest } from '../../lib/people';
import groupPhoto from '../../assets/pages/2024-08-06.lab-group2.jpg';

const { current, alumni } = await team();
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);

const index = [
  { href: '#current', label: 'In the lab' },
  { href: '#alumni', label: 'Alumni' },
  { href: '#join', label: 'Join the team' },
];
---
<Shell title="Team" description="The people of the Talmo Pereira Lab at the Salk Institute, and the alumni who came before them." index={index} indexLabel="People">
  <header class="page-head">
    <h1>Team</h1>
    <p class="lede">{current.length} people in the lab today, and {alumni.length} alumni.</p>
  </header>

  <figure class="photo">
    <Image src={groupPhoto} alt="The Talmo Pereira Lab, outdoors at the Salk Institute" width={1600} />
    <figcaption>The group, ca. 2024. Photo credit: Chris Keeney.</figcaption>
  </figure>

  <section class="section" id="current" aria-labelledby="current-h">
    <div class="section-head">
      <h2 id="current-h">In the lab</h2>
      <span class="mono muted">{current.length}</span>
    </div>
    {/* One grid in rank order (never hand-ordered), with each person's title on their
        card, rather than a heading per role: most roles have one or two people. */}
    <ul class="people">
      {current.map((p) => {
        const a = latest(p);
        const inner = (
          <>
            {p.data.image ? (
              <Image src={p.data.image} alt="" width={300} height={300} class="portrait" />
            ) : (
              <span class="portrait portrait-empty" aria-hidden="true">{initials(p.data.name)}</span>
            )}
            <span class="pname">{p.data.name}</span>
            <span class="ptitle">{label(a)}</span>
            {a.note && <span class="ptitle">{a.note}</span>}
          </>
        );
        return <li>{p.data.page ? <a href={`/members/${p.id}`}>{inner}</a> : <div style="display: flex; flex-direction: column; gap: 8px">{inner}</div>}</li>;
      })}
    </ul>
  </section>

  <section class="section" id="alumni" aria-labelledby="alumni-h">
    <div class="section-head">
      <h2 id="alumni-h">Alumni</h2>
      <span class="mono muted">{alumni.length}</span>
    </div>
    <p class="muted" style="max-width: 62ch; margin-top: -8px">
      Generated from appointment history rather than hand-maintained. A span is one
      continuous tenure; <code>–?</code> marks a departure whose date was never recorded.
    </p>
    <div class="table-scroll">
      <table class="alumni">
        <thead>
          <tr><th scope="col">Years</th><th scope="col">Name</th><th scope="col">Role</th><th scope="col">Next</th></tr>
        </thead>
        <tbody>
          {alumni.map((p) => (
            <tr>
              <td class="years">{years(p)}</td>
              <td>{p.data.page ? <a href={`/members/${p.id}`}>{p.data.name}</a> : p.data.name}</td>
              <td>{roleHistory(p).join(', ')}</td>
              <td>
                {p.data.next ? (
                  <>
                    {p.data.next.url ? <a href={p.data.next.url}>{p.data.next.org}</a> : p.data.next.org}
                    {p.data.next.what && <span class="muted">, {p.data.next.what}</span>}
                  </>
                ) : (
                  <span class="muted">–</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <Join />
</Shell>
