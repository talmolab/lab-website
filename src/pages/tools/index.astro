---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';

// The live /tools/ page is lorem ipsum (_data/tools.yaml); this is the real list, from
// src/data/repos.yaml, in its editorial order. No usage statistics (§6.3).
const repos = (await getCollection('repos')).sort((a, b) => a.data.order - b.data.order);
const GROUPS = [
  {
    id: 'maintained',
    name: 'Maintained',
    note: 'Supported, documented and released. Issues and pull requests are welcome.',
  },
  {
    id: 'research',
    name: 'Research code',
    note: 'Code that accompanies a paper or a project in progress. It moves with the research.',
  },
  { id: 'archived', name: 'Archived', note: 'Kept for reference; no longer developed.' },
] as const;

const fmtMonth = (d?: string) =>
  d ? new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : '';
---
<Base title="Tools" description="Open-source software from the Talmo Lab: SLEAP and the tools around it for pose tracking, root phenotyping and motion imitation.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="title">Tools</h1>
      <p class="lede">
        Open-source software from the lab. Most of it grows out of
        <a href="https://sleap.ai">SLEAP</a>, our framework for multi-animal pose tracking.
      </p>
      <nav class="jump meta" aria-label="Groups">
        {GROUPS.filter((g) => repos.some((r) => r.data.group === g.id)).map((g) => <a href={`#${g.id}`}>{g.name}</a>)}
        <a href="https://github.com/talmolab">All repositories on GitHub</a>
      </nav>
    </header>

    {GROUPS.map((g) => {
      const items = repos.filter((r) => r.data.group === g.id);
      if (!items.length) return null;
      return (
        <section class="ledger" id={g.id} aria-labelledby={`${g.id}-h`}>
          <header class="ledger-head">
            <h2 id={`${g.id}-h`}>{g.name}</h2>
            <span class="count">{items.length} {items.length === 1 ? 'repository' : 'repositories'}</span>
            <p>{g.note}</p>
          </header>
          <ul class:list={['tools', { two: items.length > 1 }]}>
            {items.map(({ data: r }) => {
              const docs = r.links.filter((l) => l.url !== `https://github.com/${r.repo}`);
              const home = r.homepage && !docs.some((l) => l.url.replace(/\/$/, '') === r.homepage!.replace(/\/$/, '')) ? r.homepage : undefined;
              return (
                <li class="tool" id={r.name}>
                  {r.media[0] && <Media item={r.media[0]} />}
                  <div class="tool-head">
                    <h3 class="tool-name"><a href={`https://github.com/${r.repo}`}>{r.title ?? r.name}</a></h3>
                    <span class="meta muted">{r.repo}</span>
                  </div>
                  <p class="tool-blurb">{r.blurb ?? r.description}</p>
                  <p class="tool-meta meta">
                    {r.language && <span>{r.language}</span>}
                    {r.license && r.license !== 'NOASSERTION' && <span>{r.license}</span>}
                    {r.pushedAt && <span>updated {fmtMonth(r.pushedAt)}</span>}
                  </p>
                  <p class="tool-links">
                    <a href={`https://github.com/${r.repo}`}>Source</a>
                    {docs.map((l) => <a href={l.url}>{l.label}</a>)}
                    {home && <a href={home}>Website</a>}
                  </p>
                </li>
              );
            })}
          </ul>
        </section>
      );
    })}
  </div>
</Base>
