---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { href } from '../../lib/pubs';

const areas = (await getCollection('areas', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const letters = 'abcdefghij';

type Item = (typeof areas)[number]['data']['media'][number];
type Block = { slug?: string; html: string; figs: Item[]; row: number; rows?: string };

/** An area's prose cut into its intro and one block per `###` thread, each thread with
 *  the figures that name it. The lead (the first figure) belongs to the intro. On wide
 *  screens a block's figures sit beside it and stay in view until the next block that
 *  has figures; `rows` is that span of grid rows, references included at the end. */
function blocks(a: (typeof areas)[number], threads: { slug: string }[]): Block[] {
  const html = a.rendered?.html ?? '';
  const parts = html.split(/(?=<h3 id=")/);
  if (parts.length !== threads.length + 1) {
    throw new Error(`areas/${a.id}: expected ${threads.length} top-level ### threads in the HTML, found ${parts.length - 1}`);
  }
  const out: Block[] = parts.map((h, i) => ({ slug: threads[i - 1]?.slug, html: h, figs: [], row: i + 1 }));
  const [lead, ...more] = a.data.media;
  if (lead) out[0].figs.push(lead);
  for (const m of more) {
    const b = out.find((x) => x.slug && x.slug === m.thread);
    if (!b) {
      const known = threads.map((t) => t.slug).join(', ');
      throw new Error(`areas/${a.id}: ${m.src} needs \`thread:\` set to one of: ${known}`);
    }
    b.figs.push(m);
  }
  const withFigs = out.filter((b) => b.figs.length > 0);
  withFigs.forEach((b, i) => {
    // The last group runs to the end of the references (one row after the last block).
    b.rows = `${b.row} / ${withFigs[i + 1]?.row ?? out.length + 2}`;
  });
  return out;
}

const rendered = await Promise.all(
  areas.map(async (a) => {
    const { headings } = await render(a);
    /** The area's threads: the `###` headings of its prose. */
    const threads = headings.filter((h) => h.depth === 3);
    return {
      area: a,
      threads,
      blocks: blocks(a, threads),
      tools: (await getEntries(a.data.tools)).sort((x, y) => x.data.order - y.data.order),
      papers: (await getEntries(a.data.papers)).sort((x, y) => (y.data.date ?? '').localeCompare(x.data.date ?? '')),
    };
  }),
);
---
<Base title="Research" description="Research in the Talmo Lab: biological motion capture, phenoinformatics and virtual biology.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="title">Research</h1>
      <p class="lede">
        We advance the frontier of how <strong>AI</strong> and other technologies can be
        adapted to tackle foundational biological problems that would not be tractable
        otherwise.
      </p>
      <div class="head-cols">
        <p>
          Our approach combines technical expertise in deep learning, software engineering
          and computational modeling with deep biological domain knowledge and tight
          integration with experimental research programs. Our core interests are
          neuroethology (natural behavior and its neural mechanisms), degenerative
          diseases (especially ALS and Alzheimer's disease) and systems biology
          (connecting genotype to phenotype).
        </p>
        <p>
          The lab works in three directions, each with its own workflow, methods and
          measures of success. Motion capture feeds the other two: better data and
          analytics for phenoinformatics, and better models and theories for virtual
          biology.
        </p>
      </div>
    </header>

    <nav class="directions" aria-label="Research directions">
      <ol role="list">
        {rendered.map(({ area: a, threads }, i) => (
          <li>
            <a class="dir-name" href={`#${a.id}`}>
              <span class="fig-label" aria-hidden="true">{letters[i]}</span>
              {a.data.name}
            </a>
            <p class="dir-sum">{a.data.summary}</p>
            {threads.length > 0 && (
              <ul class="dir-threads meta" role="list">
                {threads.map((t) => <li><a href={`#${t.slug}`}>{t.text}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </nav>

    {rendered.map(({ area: a, blocks, tools, papers }, i) => {
      const refsRow = blocks.length + 1;
      return (
        <section class="area" id={a.id} aria-labelledby={`${a.id}-h`}>
          <div class="area-head">
            <span class="fig-label" aria-hidden="true">{letters[i]}</span>
            <h2 id={`${a.id}-h`}>{a.data.name}</h2>
          </div>
          {a.data.goal && (
            <p class="area-goal">
              <span class="meta">Goal</span>
              {a.data.goal}
            </p>
          )}
          <div class="area-body">
            {blocks.map((b, j) => {
              const figs = b.figs.length > 0 && (
                <div class="area-figs" style={`--rows: ${b.rows}`}>
                  <div class="area-figs-in">
                    {b.figs.map((m) => (
                      <figure>
                        <Media item={m} eager={i === 0 && j === 0} class={m.width < 400 ? 'small' : undefined} />
                        {m.caption && <figcaption>{m.caption}{m.credit && ` ${m.credit}`}</figcaption>}
                      </figure>
                    ))}
                  </div>
                </div>
              );
              const text = (
                <div class:list={['prose', { thread: j > 0 }]} style={`--row: ${b.row}`} set:html={b.html} />
              );
              // Stacked, the lead comes before the intro; a thread's figures follow its text.
              return j === 0 ? <>{figs}{text}</> : <>{text}{figs}</>;
            })}
            {(tools.length > 0 || papers.length > 0) && (
              <div class="area-refs" style={`--row: ${refsRow}`}>
                {tools.length > 0 && (
                  <div>
                    <h3 class="refs-label">Software</h3>
                    <ul class="chips">
                      {tools.map((t) => <li><a href={`/tools/#${t.data.name}`}>{t.data.title ?? t.data.name}</a></li>)}
                    </ul>
                  </div>
                )}
                {papers.length > 0 && (
                  <div>
                    <h3 class="refs-label">Selected papers</h3>
                    <ul class="ref-list">
                      {papers.map(({ data: p }) => (
                        <li>
                          <a class="plain" href={`/publications/#${p.key}`}>{p.title}</a>
                          <span class="ref-meta">
                            {p.venue && <i>{p.venue}</i>}{p.date && !p.venue?.includes(p.date.slice(0, 4)) && <>{p.venue ? ', ' : ''}{p.date.slice(0, 4)}</>}
                            {href(p) && <> · <a href={href(p)}>paper</a></>}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            )}
          </div>
        </section>
      );
    })}

    <section class="band" aria-label="More">
      <p class="lede">
        See <a href="/publications/">Publications</a> for everything the lab has published,
        and <a href="/tools/">Tools</a> for the software behind it.
      </p>
    </section>
  </div>
</Base>
