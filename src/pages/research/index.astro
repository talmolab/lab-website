---
import { getCollection, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Clip from '../../components/Clip.astro';
import Wall from '../../components/Wall.astro';
import { clips, pack, shape } from '../../lib/media';

const areas = (await getCollection('areas')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  areas.map(async (a) => ({
    area: a,
    Content: (await render(a)).Content,
    lead: (await clips([a.data.lead]))[0],
    rest: await clips(a.data.media),
  })),
);

// Everything filed under an area that its page section has not already shown.
const shown = new Set(rendered.flatMap((r) => [r.lead.id, ...r.rest.map((c) => c.id)]));
const more = (await getCollection('media')).filter(
  // Keypoint layers are halves of an overlay pair, not footage on their own.
  (c) => !shown.has(c.id) && !c.id.endsWith('-kp') && c.id !== 'bees-raw',
);

const index = [
  ...areas.map((a) => ({ href: `#${a.id}`, label: a.data.name })),
  ...(more.length ? [{ href: '#more', label: 'More footage' }] : []),
];
---
<Shell title="Research" description="Research at the Talmo Pereira Lab: pose tracking, phenotyping at scale, plant roots and physics models of the body." index={index} indexLabel="Areas">
  <header class="page-head">
    <h1>Research</h1>
    <p class="lede">
      We use deep learning and computer vision to study complex biological systems, and we
      build the tools to do it. Each area below leads with footage from the work.
    </p>
  </header>

  {rendered.map(({ area, Content, lead, rest }, i) => (
    <section class="area" id={area.id} aria-labelledby={`${area.id}-h`}>
      <div class="section-head">
        <h2 id={`${area.id}-h`}><span class="mono muted" style="margin-right: 14px">{String(i + 1).padStart(2, '0')}</span>{area.data.name}</h2>
        <span class="mono muted">{1 + rest.length} clips</span>
      </div>
      <div class="area-top">
        <figure class="photo">
          <div style={shape(lead)}>
            <Clip clip={lead} chip={`${lead.data.tool} · ${lead.data.title}`} />
          </div>
          <figcaption>{lead.data.caption}</figcaption>
        </figure>
        <div class="prose"><Content /></div>
      </div>
      {rest.length > 0 && <Wall rows={pack(rest)} />}
    </section>
  ))}

  {more.length > 0 && (
    <section class="section" id="more" aria-labelledby="more-h">
      <div class="section-head">
        <h2 id="more-h">More footage</h2>
        <span class="mono muted">{more.length} clips</span>
      </div>
      <Wall rows={pack(more)} label="tool" />
    </section>
  )}
</Shell>

<style>
  /* The lead keeps its own shape: the frame takes the clip's ratio from --w/--h. */
  .area-top .photo > div :global(.frame) { aspect-ratio: var(--w) / var(--h); max-height: 70vh; }
</style>
