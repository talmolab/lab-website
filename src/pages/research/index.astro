---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Media from '../../components/Media.astro';
import { href } from '../../lib/pubs';

const areas = (await getCollection('areas', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const letters = 'abcdefghij';

const rendered = await Promise.all(
  areas.map(async (a) => ({
    area: a,
    Content: (await render(a)).Content,
    tools: (await getEntries(a.data.tools)).sort((x, y) => x.data.order - y.data.order),
    papers: (await getEntries(a.data.papers)).sort((x, y) => (y.data.date ?? '').localeCompare(x.data.date ?? '')),
  })),
);
---
<Base title="Research" description="Research in the Talmo Pereira Lab: computational ethology, complex morphology phenotyping and neuro-AI modeling.">
  <div class="wrap">
    <header class="page-head">
      <h1 class="title">Research</h1>
      <p class="lede">
        Our lab leverages <strong>deep learning</strong> and <strong>computer vision</strong> to
        study complex biological systems by <strong>building novel computational tools</strong>.
      </p>
      <nav class="jump mono" aria-label="Research areas">
        {areas.map((a, i) => <a href={`#${a.id}`}>{letters[i]}. {a.data.name}</a>)}
      </nav>
    </header>

    {rendered.map(({ area: a, Content, tools, papers }, i) => {
      const [lead] = a.data.media;
      const small = lead && lead.width < 400;
      return (
        <section class="area" id={a.id} aria-labelledby={`${a.id}-h`}>
          <div class="area-head">
            <span class="fig-label" aria-hidden="true">{letters[i]}</span>
            <h2 id={`${a.id}-h`}>{a.data.name}</h2>
          </div>
          <div class="area-body">
            {lead && (
              <figure class="area-fig">
                <Media item={lead} eager={i === 0} class={small ? 'small' : undefined} />
                {lead.caption && <figcaption>{lead.caption}{lead.credit && ` ${lead.credit}`}</figcaption>}
              </figure>
            )}
            <div>
              <div class="prose"><Content /></div>
              {(tools.length > 0 || papers.length > 0) && (
                <div class="area-refs">
                  {tools.length > 0 && (
                    <div>
                      <h3 class="refs-label">Software</h3>
                      <ul class="chips">
                        {tools.map((t) => <li><a href={`/tools/#${t.data.name}`}>{t.data.title ?? t.data.name}</a></li>)}
                      </ul>
                    </div>
                  )}
                  {papers.length > 0 && (
                    <div>
                      <h3 class="refs-label">Selected papers</h3>
                      <ul class="ref-list">
                        {papers.map(({ data: p }) => (
                          <li>
                            <a class="plain" href={`/publications/#${p.key}`}>{p.title}</a>
                            <span class="ref-meta">
                              {p.venue && <i>{p.venue}</i>}{p.date && !p.venue?.includes(p.date.slice(0, 4)) && <>{p.venue ? ', ' : ''}{p.date.slice(0, 4)}</>}
                              {href(p) && <> · <a href={href(p)}>paper</a></>}
                            </span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })}

    <section class="band" aria-label="More">
      <p class="lede">
        See <a href="/publications/">Publications</a> for everything the lab has published,
        and <a href="/tools/">Tools</a> for the software behind it.
      </p>
    </section>
  </div>
</Base>
