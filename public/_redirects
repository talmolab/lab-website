# No page has ever lived at /members/ itself; the people index is the Team page.
/members   /team/  301
/members/  /team/  301

# Jekyll served member pages at /members/<slug>.html and everything else at a
# trailing slash. Workers' default html_handling (auto-trailing-slash) already
# redirects the .html form, but with a 307 — which does not move Google's index.
# These rules pre-empt it with a real 301. _redirects is evaluated BEFORE
# html_handling, and :slug binds correctly against the .html suffix (verified).
/members/:slug.html  /members/:slug  301

# Jekyll's other two shapes for every section page: /<section> (GitHub Pages 301s it
# to the slash) and /<section>/index.html (GitHub Pages serves it at 200). Workers
# would answer both with a 307 to the slash, so these make them real 301s.
# Listed one by one: a /:section placeholder would also catch /feed.xml and friends.
/index.html                /               301
/research                  /research/      301
/research/index.html       /research/      301
/publications              /publications/  301
/publications/index.html   /publications/  301
/team                      /team/          301
/team/index.html           /team/          301
/join                      /join/          301
/join/index.html           /join/          301
/tools                     /tools/         301
/tools/index.html          /tools/         301
/blog                      /blog/          301
/blog/index.html           /blog/          301

